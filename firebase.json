{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "tsl-facility-manager",
          "appId": "1:745444148924:android:8f88305dccbe2bd74db2b9",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "tsl-facility-manager",
          "appId": "1:745444148924:ios:5c189e8ae4397bfd4db2b9",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "tsl-facility-manager",
          "configurations": {
            "android": "1:745444148924:android:8f88305dccbe2bd74db2b9",
            "ios": "1:745444148924:ios:5c189e8ae4397bfd4db2b9"
          }
        }
      }
    }
  },
  "firestore": [
    {
      "database": "tsl-app",
      "location": "eur3",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "functions": {
      "host": "127.0.0.1",
      "port": 5001
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        "src",
        "*.log"
      ]
    }
  ],
  "hosting": {
    "public": "hosting",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*"
    ]
  }
}
