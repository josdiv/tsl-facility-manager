{
  "name": "tsl-firebase-rules-test",
  "private": true,
  "type": "module",
  "description": "Security rules tests for Firestore and Storage, run against the Firebase emulators.",
  "scripts": {
    "test": "firebase emulators:exec --only firestore,storage --project demo-tsl \"node --test --test-concurrency=1 'test/*.test.js'\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0"
  }
}
