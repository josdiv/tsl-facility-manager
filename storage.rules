rules_version = '2';

// TSL Facility Manager Cloud Storage rules. Paths and limits are described in
// docs/firestore-schema.md ("Cloud Storage layout"). Access follows the
// matching Firestore documents in the app's tsl-app database, so these rules
// read Firestore.

service firebase.storage {
  match /b/{bucket}/o {

    function me() {
      return firestore.get(/databases/tsl-app/documents/users/$(request.auth.uid)).data;
    }

    function active() {
      return request.auth != null
        && firestore.exists(/databases/tsl-app/documents/users/$(request.auth.uid))
        && me().status == 'active';
    }

    function image(maxMb) {
      return request.resource.size < maxMb * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|heic|heif)');
    }

    function canReadWorkOrder(order) {
      return me().role == 'admin'
        || (me().role == 'client' && order.clientId == request.auth.uid)
        || (me().role == 'staff' && order.assignedToId == request.auth.uid)
        || (me().role == 'supervisor' && order.locationId == me().locationId);
    }

    match /workOrders/{workOrderId}/{kind}/{fileName} {
      function order() {
        return firestore.get(/databases/tsl-app/documents/workOrders/$(workOrderId)).data;
      }

      function orderExists() {
        return firestore.exists(/databases/tsl-app/documents/workOrders/$(workOrderId));
      }

      allow read: if active()
        && kind in ['report', 'work', 'return', 'inspection']
        && orderExists()
        && canReadWorkOrder(order());

      // Files are never replaced or deleted by the app. Cleanup of photos
      // that never got attached is done by a Cloud Function.
      allow update, delete: if false;

      allow create: if active() && image(10) && (
        // A client uploads report photos just before calling reportIssue,
        // using the work order ID the app picked.
        (kind == 'report' && me().role == 'client' && !orderExists())
        // The technician uploads proof while the task is in their hands.
        || (kind == 'work' && orderExists()
            && me().role == 'staff'
            && order().assignedToId == request.auth.uid
            && order().status in ['in_progress', 'returned'])
        // The supervisor uploads evidence when returning or confirming the
        // work.
        || (kind in ['return', 'inspection'] && orderExists()
            && me().role == 'supervisor'
            && order().locationId == me().locationId
            && order().status == 'pending_review')
      );
    }

    match /documents/{documentId}/{fileName} {
      allow read: if active() && (
        me().role == 'admin'
        || (me().role in ['staff', 'supervisor']
            && firestore.get(/databases/tsl-app/documents/documents/$(documentId)).data.locationId == me().locationId)
      );
      allow write: if active() && me().role == 'admin'
        && (request.resource == null || request.resource.size < 25 * 1024 * 1024);
    }

    match /inventory/{itemId}/{fileName} {
      allow read: if active() && me().role in ['admin', 'staff', 'supervisor'];
      allow write: if active() && me().role == 'admin'
        && (request.resource == null || image(10));
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
